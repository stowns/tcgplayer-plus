{
  "name": "tcgplayer-plus",
  "version": "1.0.0",
  "description": "Firefox and Chrome extension for TCGplayer: watch lists with price trends, and your order history with what each card would cost today.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "package": "node scripts/package.js",
    "pretest": "npm run build",
    "lint": "npx web-ext lint --source-dir dist/firefox",
    "build:stripes": "node scripts/build.js all --icon=stripes",
    "package:firefox": "node scripts/package.js firefox",
    "package:chrome": "node scripts/package.js chrome"
  },
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  }
}
