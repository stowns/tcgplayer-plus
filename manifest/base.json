{
  "manifest_version": 3,
  "name": "TCGPlayer+",
  "version": "1.0.0",
  "description": "Save TCGplayer products to your own lists with price trends, and see your order history with what each card would cost today, including shipping.",
  "homepage_url": "https://github.com/simontownsend/pokemon-tcg-browser-extension",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.tcgplayer.com/*",
    "https://store.tcgplayer.com/*",
    "https://infinite-api.tcgplayer.com/*",
    "https://mp-search-api.tcgplayer.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tcgplayer.com/product/*"
      ],
      "js": [
        "content/tcgplayerProduct.js"
      ],
      "css": [
        "content/lists.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.tcgplayer.com/*"
      ],
      "js": [
        "content/tcgplayerOrders.js"
      ],
      "css": [
        "content/orders.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TCGPlayer+",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
